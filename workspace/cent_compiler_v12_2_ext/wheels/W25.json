{
  "id": "W25",
  "title": "Plasma Physics & Magnetohydrodynamics",
  "axioms": [
    "cyclotron_frequency = magnetic_field * charge / mass",
    "alfven_velocity = magnetic_field / (permeability * mass_density)^(1/2)"
  ],
  "cases": [
    {
      "id": "W25-01",
      "equation": "magnetic_field = cyclotron_frequency * mass / charge",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "cyclotron_frequency = q*B/m, rearranged. Both axioms previously omitted the fundamental constant that carries the missing dimension: charge here, permeability in the Alfven relation."
    },
    {
      "id": "W25-02",
      "equation": "mass = magnetic_field * charge / cyclotron_frequency",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "mass = q*B/omega_c, rearranged."
    },
    {
      "id": "W25-03",
      "equation": "mass_density = (magnetic_field / alfven_velocity)^2 / permeability",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "Alfven: v_A = B/sqrt(mu_0*rho), so rho = (B/v_A)^2/mu_0."
    },
    {
      "id": "W25-N1",
      "equation": "cyclotron_frequency = mass / magnetic_field",
      "expected_dimensional": false,
      "expected_derivable": false,
      "physical_status": "negative_control",
      "expected_dimensional_explicit": null,
      "note": "Negative control: mass and magnetic_field swapped; also dimensionally wrong."
    }
  ],
