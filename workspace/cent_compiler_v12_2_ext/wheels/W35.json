{
  "id": "W35",
  "title": "Electrophysiology & Membrane Transport",
  "axioms": [
    "membrane_voltage = gas_constant * temperature / (valence * faraday_constant)",
    "ion_flux = diffusion_coefficient * ion_concentration / length_scale"
  ],
  "cases": [
    {
      "id": "W35-01",
      "equation": "valence = gas_constant * temperature / (membrane_voltage * faraday_constant)",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": true,
      "note": "Complete Nernst relation with gas constant and Faraday constant declared explicitly."
    },
    {
      "id": "W35-02",
      "equation": "temperature = membrane_voltage * valence * faraday_constant / gas_constant",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": true,
      "note": "Complete Nernst relation with gas constant and Faraday constant declared explicitly."
    },
    {
      "id": "W35-03",
      "equation": "ion_concentration = ion_flux * length_scale / diffusion_coefficient",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": true,
      "note": "Fick flux rearranged with the required concentration-gradient length scale."
    },
    {
      "id": "W35-N1",
      "equation": "membrane_voltage = valence / temperature",
      "expected_dimensional": false,
      "expected_derivable": false,
      "physical_status": "negative_control",
      "expected_dimensional_explicit": null,
      "note": ""
    }
  ],
