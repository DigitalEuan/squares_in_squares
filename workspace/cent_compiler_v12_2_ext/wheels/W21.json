{
  "id": "W21",
  "title": "Fracture Mechanics & Plasticity",
  "axioms": [
    "fracture_toughness^2 = 2 * youngs_modulus * surface_energy / (314159265 * crack_length)",
    "stress_intensity_factor = dimensionless_factor * stress * crack_length^(1/2)"
  ],
  "cases": [
    {
      "id": "W21-01",
      "equation": "surface_energy = fracture_toughness^2 * 314159265 * crack_length / (2 * youngs_modulus)",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "Carries the same dimensionless constant (314159265) as the W21 axiom so the case is exactly derivable. That constant appears to be pi written without its decimal point (3.14159265); it is dimensionless so it changes no dimensional result, but the value needs an owner decision - see docs/INVENTORY.md."
    },
    {
      "id": "W21-02",
      "equation": "crack_length = (stress_intensity_factor / (dimensionless_factor * stress))^2",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "stress_intensity_factor carries L^(1/2) (i.e. Pa*sqrt(m)), which is what makes this case and W21-03 balance. The wheel previously declared it as Pa."
    },
    {
      "id": "W21-03",
      "equation": "stress = stress_intensity_factor / (dimensionless_factor * crack_length^(1/2))",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": ""
    },
    {
      "id": "W21-N1",
      "equation": "fracture_toughness = stress / crack_length",
      "expected_dimensional": false,
      "expected_derivable": false,
      "physical_status": "negative_control",
      "expected_dimensional_explicit": null,
      "note": ""
    }
  ],
