{
  "id": "W37",
  "title": "Viscoelastic Settling (SciPy) — Maxwell creep and dissipation",
  "axioms": [
    "relaxation_time = viscosity / modulus",
    "strain_rate = stress / viscosity",
    "dissipated_power = stress * strain_rate"
  ],
  "cases": [
    {
      "id": "W37-01",
      "equation": "viscosity = relaxation_time * modulus",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": ""
    },
    {
      "id": "W37-02",
      "equation": "stress = strain_rate * viscosity",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": ""
    },
    {
      "id": "W37-03",
      "equation": "strain_rate = stress / (relaxation_time * modulus)",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "Substituting viscosity = relaxation_time * modulus into the Maxwell axiom strain_rate = stress / viscosity. The previous case read stress / modulus, which is dimensionless."
    },
    {
      "id": "W37-04",
      "equation": "dissipated_power = stress^2 / viscosity",
      "expected_dimensional": true,
      "expected_derivable": true,
      "physical_status": "physically_supported",
      "expected_dimensional_explicit": null,
      "note": "Substituting strain_rate = stress / viscosity into the dissipation axiom dissipated_power = stress * strain_rate. The previous case read stress / strain_rate, which has the wrong units for a power density."
    }
  ],
